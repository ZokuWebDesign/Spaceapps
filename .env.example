# Google Sheets API Configuration
# You need to create a Google Service Account and get these credentials
# Follow the setup instructions in the README

# Google Service Account Email
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Google Service Account Private Key (keep the quotes and line breaks)
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----"

# Main Google Spreadsheet ID (get from the URL of your main sheet)
GOOGLE_SHEETS_MAIN_ID=your_main_spreadsheet_id_here

# Backup Google Spreadsheet ID (get from the URL of your backup sheet)
GOOGLE_SHEETS_BACKUP_ID=your_backup_spreadsheet_id_here

# API URL Configuration
# For development (uses local Next.js API routes)
NEXT_PUBLIC_API_URL=http://localhost:3000

# For production (uncomment and update with your Render URL)
# NEXT_PUBLIC_API_URL=https://your-api-name.onrender.com

# Google Analytics - Measurement ID (e.g. G-XXXXXXXXXX)
PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Google Tag Manager - Container ID (e.g. GTM-XXXXXXX)
PUBLIC_GTM_ID=GTM-XXXXXXX
PUBLIC_GOOGLE_TAG_ID=AW-XXXXXXXXX

# Microsoft Clarity - Project ID
PUBLIC_CLARITY_ID=xxxxxxxxxx

